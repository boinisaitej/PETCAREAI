# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret — generate with: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# SQLite by default; any SQLAlchemy URL works (Postgres recommended in production)
DATABASE_URL=sqlite:///./petcare.db

# Directory for uploaded photos/documents (must be writable / a persistent disk in production)
UPLOAD_DIR=uploads

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated allowed frontend origins for CORS.
# Local dev default is * (no credentials). In production set your Vercel domain(s):
# FRONTEND_ORIGINS=https://your-app.vercel.app,http://localhost:3000
FRONTEND_ORIGINS=*

# Seed demo accounts/data automatically when the database is empty (first boot).
# Set to false to start with a blank database.
AUTO_SEED_DEMO=true
