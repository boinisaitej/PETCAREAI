{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_env.py\"",
            "timeout": 15,
            "statusMessage": "Checking .env protection..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"$CLAUDE_PROJECT_DIR/.claude/hooks/backend_import_check.py\"",
            "timeout": 120,
            "statusMessage": "Verifying backend still imports..."
          }
        ]
      }
    ]
  }
}
